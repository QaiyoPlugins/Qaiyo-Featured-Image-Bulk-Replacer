msgid "Qaiyo Plugins"
msgstr "Плагины Qaiyo"

msgid "Hi, %s!"
msgstr "Привет, %s!"

msgid "Featured Image Bulk Replacer"
msgstr "Массовая замена изображений записи"

msgid "Featured Images"
msgstr "Изображения записи"

msgid "You do not have permission to access this page."
msgstr "У вас нет прав для доступа к этой странице."

msgid "Replace the featured image of published posts with an image that already exists in your Media Library. Filter by date, scope and category, preview the result, then run it in safe batches — and restore the originals at any time."
msgstr "Замените изображение записи опубликованных записей на изображение, которое уже есть в вашей Медиабиблиотеке. Фильтруйте по дате, охвату и рубрике, просмотрите результат, затем выполните замену безопасными партиями — и восстановите оригиналы в любой момент."

msgid "Replacement settings"
msgstr "Настройки замены"

msgid "New featured image"
msgstr "Новое изображение записи"

msgid "Choose from Media Library"
msgstr "Выбрать из Медиабиблиотеки"

msgid "Pick an image from the Media Library, or paste the URL of an image that is already uploaded. Nothing is downloaded."
msgstr "Выберите изображение из Медиабиблиотеки или вставьте URL уже загруженного изображения. Ничего не скачивается."

msgid "Target scope"
msgstr "Охват"

msgid "All matching posts"
msgstr "Все подходящие записи"

msgid "Only posts without a featured image"
msgstr "Только записи без изображения записи"

msgid "Post type"
msgstr "Тип записи"

msgid "Category"
msgstr "Рубрика"

msgid "All categories"
msgstr "Все рубрики"

msgid "Category filter applies to standard posts."
msgstr "Фильтр по рубрике применяется к стандартным записям."

msgid "After date (optional)"
msgstr "С даты (необязательно)"

msgid "Only posts published on or after this date are affected. Leave empty for no lower bound."
msgstr "Затрагиваются только записи, опубликованные в эту дату или позже. Оставьте пустым, чтобы не задавать нижнюю границу."

msgid "Before date"
msgstr "До даты"

msgid "Only posts published strictly before this date are affected (the date itself is excluded)."
msgstr "Затрагиваются только записи, опубликованные строго до этой даты (сама дата исключается)."

msgid "Alt / title text (optional)"
msgstr "Текст alt / заголовок (необязательно)"

msgid "If filled, the alt and title of the chosen Media Library image are set to this text once. Leave empty to keep them unchanged."
msgstr "Если заполнено, alt и заголовок выбранного изображения один раз устанавливаются на этот текст. Оставьте пустым, чтобы не изменять их."

msgid "Preview"
msgstr "Просмотр"

msgid "Test run (max %d posts)"
msgstr "Тестовый запуск (макс. %d записей)"

msgid "Live run (all matching posts)"
msgstr "Реальный запуск (все подходящие записи)"

msgid "Tip: back up your database before a live run. Posts are processed in small batches so large sites do not time out. The original featured image of every changed post is stored so you can restore it below."
msgstr "Совет: сделайте резервную копию базы данных перед реальным запуском. Записи обрабатываются небольшими партиями, поэтому крупные сайты не превышают лимит времени. Исходное изображение записи каждой изменённой записи сохраняется, чтобы его можно было восстановить ниже."

msgid "Restore originals"
msgstr "Восстановить оригиналы"

msgid "Restores the original featured image of every post the plugin previously changed."
msgstr "Восстанавливает исходное изображение записи каждой записи, которую плагин ранее изменил."

msgid "Restorable posts:"
msgstr "Записи для восстановления:"

msgid "Restore original featured images"
msgstr "Восстановить исходные изображения записи"

msgid "Nothing to restore right now."
msgstr "Сейчас нечего восстанавливать."

msgid "Last run"
msgstr "Последний запуск"

msgid "No runs yet."
msgstr "Запусков пока нет."

msgid "Restore on %1$s — restored: %2$d, skipped: %3$d, errors: %4$d."
msgstr "Восстановление (%1$s) — восстановлено: %2$d, пропущено: %3$d, ошибок: %4$d."

msgid "test"
msgstr "тест"

msgid "live"
msgstr "реальный"

msgid "Replacement (%1$s) on %2$s — matched: %3$d, replaced: %4$d, skipped: %5$d, errors: %6$d."
msgstr "Замена (%1$s) — %2$s — совпадений: %3$d, заменено: %4$d, пропущено: %5$d, ошибок: %6$d."

msgid "Qaiyo Featured Image Bulk Replacer v%s — by"
msgstr "Qaiyo Featured Image Bulk Replacer v%s — от"

msgid "You do not have permission to perform this action."
msgstr "У вас нет прав для выполнения этого действия."

msgid "Please enter a valid “before” date."
msgstr "Введите корректную дату «до»."

msgid "Please choose an image from the Media Library or paste an image URL."
msgstr "Выберите изображение из Медиабиблиотеки или вставьте URL изображения."

msgid "No Media Library image was found for that URL. Make sure the image is already uploaded."
msgstr "Для этого URL не найдено изображение в Медиабиблиотеке. Убедитесь, что изображение уже загружено."

msgid "The job expired. Please start again."
msgstr "Задача истекла. Начните заново."

msgid "skip (already correct)"
msgstr "пропустить (уже верно)"

msgid "replace"
msgstr "заменить"

msgid "Media Library attachment ID: %1$d. Matched posts: %2$d — to replace: %3$d, to skip: %4$d."
msgstr "ID вложения библиотеки: %1$d. Совпадений: %2$d записей — заменить: %3$d, пропустить: %4$d."

msgid "No posts match these criteria."
msgstr "Нет записей, соответствующих этим условиям."

msgid "Showing the first %1$d of %2$d matching posts."
msgstr "Показаны первые %1$d из %2$d подходящих записей."

msgid "ID"
msgstr "ID"

msgid "Image"
msgstr "Изображение"

msgid "Title"
msgstr "Заголовок"

msgid "Date"
msgstr "Дата"

msgid "Action"
msgstr "Действие"

msgid "Select the new featured image"
msgstr "Выберите новое изображение записи"

msgid "Use this image"
msgstr "Использовать это изображение"

msgid "Loading preview…"
msgstr "Загрузка просмотра…"

msgid "Could not load the preview."
msgstr "Не удалось загрузить просмотр."

msgid "Please choose an image and a date first."
msgstr "Сначала выберите изображение и дату."

msgid "Preparing…"
msgstr "Подготовка…"

msgid "Processing…"
msgstr "Обработка…"

msgid "Nothing to process."
msgstr "Нечего обрабатывать."

msgid "Something went wrong. Please try again."
msgstr "Что-то пошло не так. Попробуйте ещё раз."

msgid "Run the TEST replacement on the first few matching posts?"
msgstr "Выполнить ТЕСТОВУЮ замену для первых подходящих записей?"

msgid "Run the LIVE bulk featured-image replacement on ALL matching posts?"
msgstr "Выполнить РЕАЛЬНУЮ массовую замену изображений записи для ВСЕХ подходящих записей?"

msgid "Restore the original featured image of every affected post?"
msgstr "Восстановить исходное изображение записи каждой затронутой записи?"

msgid "Pro features"
msgstr "Функции Pro"

msgid "Background processing & scheduling"
msgstr "Фоновая обработка и планирование"

msgid "Offload large runs to a server-friendly background queue with adaptive batch size, throttling and an off-peak window — or schedule a run for later. No need to keep the browser open."
msgstr "Передайте крупные запуски в бережную к серверу фоновую очередь с адаптивным размером партии, ограничением скорости и окном непиковых часов — или запланируйте запуск на потом. Браузер можно не держать открытым."

msgid "Automatic featured image"
msgstr "Автоматическое изображение записи"

msgid "Automatically set a fallback featured image when a post is published without one — by post type and category, optionally using the first image found in the content."
msgstr "Автоматически устанавливает резервное изображение записи, когда запись публикуется без него — по типу записи и рубрике, при необходимости используя первое изображение из содержимого."

msgid "Run history & per-run restore"
msgstr "История запусков и восстановление по запуску"

msgid "Keep a history of every run and roll back any single run independently, plus an email report when a background job finishes."
msgstr "Хранит историю каждого запуска и позволяет независимо откатить любой запуск, плюс отчёт по электронной почте по завершении фоновой задачи."

msgid "Unlock in Pro →"
msgstr "Разблокировать в Pro →"

msgid "Qaiyo Featured Image Bulk Replacer Pro"
msgstr "Qaiyo Featured Image Bulk Replacer Pro"

msgid "Get Pro"
msgstr "Получить Pro"
